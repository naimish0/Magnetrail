    <string name="tutorial_1_title">Oku takip et</string>
    <string name="tutorial_1_message">Ok ucu, yazdırılan yönünü gösterir. Bir mıknatıs bu rotayı bükebilir.</string>
    <string name="tutorial_1_prompt">Eline dikkat edin ve ardından parlayan oka dokunun.</string>
    <string name="tutorial_2_title">Nokta engelleyiciler</string>
    <string name="tutorial_2_message">Duvarlar ve diğer oklar bir rotayı durdurur. Başarısız bir başlatma hiçbir şeyi değiştirmez.</string>
    <string name="tutorial_2_prompt">Parlayan yönü takip edin ve ardından oku deneyin.</string>
    <string name="tutorial_3_title">Alanı oku</string>
    <string name="tutorial_3_message">PULL hizalanmış bir oku yaklaştırır. PUSH onu uzaklaştırır.</string>
    <string name="tutorial_3_prompt">Mıknatıs halkalarını izleyin ve ardından parlayan oka dokunun.</string>
    <string name="tutorial_4_title">Çevirmeyi kontrol et</string>
    <string name="tutorial_4_message">Başarılı bir manyetik hareket, PULL\'u PUSH\'a veya PUSH\'u PULL\'a çevirir.</string>
    <string name="tutorial_4_prompt">Hareketin ardından duraklatın ve mıknatısı tekrar kontrol edin.</string>
    <string name="tutorial_5_title">Siparişi seçin</string>
    <string name="tutorial_5_message">İlk hamleniz daha sonra nelerin işe yarayabileceğini değiştirir.</string>
    <string name="tutorial_5_prompt">Eli takip edin ve her hareketin neleri değiştirdiğine dikkat edin.</string>
    <string name="tutorial_6_title">Tahtayı tarayın</string>
    <string name="tutorial_6_message">Dokunmadan önce ok ucunu takip edin ve hizalanan her nesneyi kontrol edin.</string>
    <string name="tutorial_6_prompt">Önce tarayın, ardından eli sırayla takip edin.</string>
    <string name="tutorial_7_title">Görünürlüğü kontrol edin</string>
    <string name="tutorial_7_message">Yalnızca görünür şekilde hizalanmış bir mıknatıs bir oku kontrol edebilir. Nesneler alanını engelleyebilir.</string>
    <string name="tutorial_7_prompt">Eli takip edin ve hangi alanın göründüğünü izleyin.</string>
    <string name="tutorial_8_title">Neyin açıldığını izle</string>
    <string name="tutorial_8_message">Bir okun kaldırılması bir rotayı veya farklı bir denetleyiciyi ortaya çıkarabilir.</string>
    <string name="tutorial_8_prompt">Her dokunuştan sonra eli takip etmeden önce tekrar bakın.</string>
    <string name="tutorial_9_title">Seçenekleri karşılaştır</string>
    <string name="tutorial_9_message">İki ok güvenli görünebilir ancak gelecekte farklı panolar oluşturabilirler.</string>
    <string name="tutorial_9_prompt">Güvenilir bir diziyi incelemek için elinizi kullanın.</string>
    <string name="tutorial_10_title">Bir araya getirin</string>
    <string name="tutorial_10_message">Her hareketten önce yönü, engelleyicileri, alanı, polariteyi ve sırayı okuyun.</string>
    <string name="tutorial_10_prompt">Rehberli diziyi tamamlayın, ardından tek başınıza oynamaya hazırsınız.</string>
    <string name="tutorial_next_prompt">Güzel. Bir sonraki oka kadar eli takip edin.</string>
    <string name="tutorial_restart_prompt">Kılavuzlu yol değişti. Adım adım sırayı tekrar göstermek için yeniden başlatın.</string>
