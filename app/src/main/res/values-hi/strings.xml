    <string name="tutorial_description">ट्यूटोरियल %2$d में से %1$d। %3$s। %4$s %5$s</string>
    <string name="tutorial_header">सीखें %2$d में से %1$d · %3$s</string>
    <string name="tutorial_1_title">तीर का अनुसरण करें</string>
    <string name="tutorial_1_message">तीर का सिरा उसकी अंकित दिशा दिखाता है। चुंबक उस रास्ते को मोड़ सकता है।</string>
    <string name="tutorial_1_prompt">हाथ देखें, फिर चमकते तीर पर टैप करें।</string>
    <string name="tutorial_2_title">रुकावट पहचानें</string>
    <string name="tutorial_2_message">दीवारें और दूसरे तीर रास्ता रोकते हैं। असफल चाल से कुछ नहीं बदलता।</string>
    <string name="tutorial_2_prompt">चमकती दिशा देखें, फिर तीर आज़माएँ।</string>
    <string name="tutorial_3_title">फ़ील्ड समझें</string>
    <string name="tutorial_3_message">खींचें पास लाता है। धकेलें दूर भेजता है।</string>
    <string name="tutorial_3_prompt">चुंबक के छल्ले देखें, फिर चमकते तीर पर टैप करें।</string>
    <string name="tutorial_4_title">पलटाव देखें</string>
    <string name="tutorial_4_message">सफल चुंबकीय चाल खींचें को धकेलें में, या धकेलें को खींचें में बदल देती है।</string>
    <string name="tutorial_4_prompt">चाल के बाद रुकें और चुंबक फिर देखें।</string>
    <string name="tutorial_5_title">क्रम चुनें</string>
    <string name="tutorial_5_message">आपकी पहली चाल बदलती है कि आगे क्या काम करेगा।</string>
    <string name="tutorial_5_prompt">हाथ का अनुसरण करें और हर चाल का बदलाव देखें।</string>
    <string name="tutorial_6_title">बोर्ड जाँचें</string>
    <string name="tutorial_6_message">टैप करने से पहले तीर की दिशा और हर सीध वाली वस्तु जाँचें।</string>
    <string name="tutorial_6_prompt">पहले जाँचें, फिर क्रम में हाथ का अनुसरण करें।</string>
    <string name="tutorial_7_title">दृश्यता जाँचें</string>
    <string name="tutorial_7_message">केवल दिखाई देने वाला सीध का चुंबक तीर को नियंत्रित कर सकता है। वस्तुएँ फ़ील्ड रोक सकती हैं।</string>
    <string name="tutorial_7_prompt">हाथ का अनुसरण करें और देखें कौन सा फ़ील्ड दिखाई देता है।</string>
    <string name="tutorial_8_title">देखें क्या खुलता है</string>
    <string name="tutorial_8_message">एक तीर हटाने से रास्ता या दूसरा नियंत्रक खुल सकता है।</string>
    <string name="tutorial_8_prompt">हर टैप के बाद हाथ का अनुसरण करने से पहले फिर देखें।</string>
    <string name="tutorial_9_title">विकल्पों की तुलना करें</string>
    <string name="tutorial_9_message">दो तीर सुरक्षित लग सकते हैं, लेकिन वे अलग आगे के बोर्ड बना सकते हैं।</string>
    <string name="tutorial_9_prompt">एक भरोसेमंद क्रम समझने के लिए हाथ का उपयोग करें।</string>
    <string name="tutorial_10_title">सब साथ लाएँ</string>
    <string name="tutorial_10_message">हर चाल से पहले दिशा, रुकावट, फ़ील्ड, ध्रुवता और क्रम पढ़ें।</string>
    <string name="tutorial_10_prompt">निर्देशित क्रम पूरा करें, फिर आप अकेले खेलने के लिए तैयार हैं।</string>
    <string name="tutorial_next_prompt">अच्छा। अगले तीर तक हाथ का अनुसरण करें।</string>
    <string name="tutorial_restart_prompt">निर्देशित रास्ता बदल गया। चरण-दर-चरण क्रम फिर देखने के लिए रीस्टार्ट करें।</string>

    <string name="close_privacy_policy">गोपनीयता नीति बंद करें</string>
    <string name="privacy_policy">गोपनीयता नीति</string>
    <string name="privacy_last_updated">अंतिम अपडेट 24 अगस्त 2026</string>
    <string name="privacy_overview_heading">परिचय</string>
    <string name="privacy_overview_body">Magnetrail एक ऑफ़लाइन-प्रथम पहेली गेम है और इसमें खाते की आवश्यकता नहीं है। गेम बोर्ड, सेटिंग, क्रमांकित अभियान प्रगति और ऑटो यात्रा इतिहास इस डिवाइस पर संग्रहीत होते हैं।</string>
    <string name="privacy_ads_heading">विज्ञापन और सहमति</string>
    <string name="privacy_ads_body">ऐप में Google Mobile Ads और Google का User Messaging Platform शामिल है। विज्ञापन चालू होने और सहमति मिलने पर Google और उसके विज्ञापन साझेदार विज्ञापन देने, सीमित करने, मापने और धोखाधड़ी रोकने के लिए डिवाइस या विज्ञापन पहचानकर्ता, IP से अनुमानित स्थान, ऐप गतिविधि, निदान और Google की नीतियों में वर्णित अन्य डेटा प्राप्त कर सकते हैं। सहमति न मिलने या अनिर्णीत रहने पर खेल विज्ञापन की प्रतीक्षा किए बिना चलता रहता है। पुरस्कार वाले विज्ञापन वैकल्पिक हैं, उनकी कोई ऐप दैनिक सीमा नहीं है और पूरा देखने पर ही संकेत या योग्य लेवल स्किप देते हैं। अभियान लेवल 1–10 इंटरस्टिशियल में नहीं गिने जाते; लेवल 11 पहला अवसर बनाता है, फिर अभियान, सामान्य अनंत और ऑटो यात्रा में साझा हर पाँच पहली जीत पर अवसर मिलता है। हल किया बोर्ड दर्ज होने के बाद योग्य इंटरस्टिशियल जाँचा जाता है और उत्सव स्क्रीन पर दिख सकता है। कोई दैनिक सीमा या सामान्य कूलडाउन नहीं है, लेकिन पुरस्कार विज्ञापन के बाद 60 सेकंड तक इंटरस्टिशियल नहीं दिखता। ऐप खुलने का विज्ञापन Magnetrail के सामने आने पर दिख सकता है, पर घंटे में एक बार से अधिक और किसी पूर्ण-स्क्रीन विज्ञापन के 60 सेकंड के भीतर नहीं। अनुपलब्ध या अयोग्य विज्ञापन छोड़ दिया जाता है और शुरुआत या वापसी को नहीं रोकता।</string>
    <string name="privacy_storage_heading">स्थानीय संग्रह और हटाना</string>
    <string name="privacy_storage_body">प्रगति, रिकॉर्ड, सेटिंग, विज्ञापन क्रम, सहमति स्थिति और ऑटो यात्रा बोर्ड ऐप स्टोरेज में रखे जाते हैं। क्लाउड बैकअप और डिवाइस ट्रांसफ़र बंद हैं। ऐप डेटा साफ़ करने या अनइंस्टॉल करने से यह स्थानीय डेटा हटता है और ऑटो यात्रा का स्थानीय विशिष्टता इतिहास रीसेट होता है। Google और अन्य प्रदाता अपने संसाधित डेटा पर अपनी अवधारण और हटाने की नीतियाँ लागू करते हैं।</string>
    <string name="privacy_sharing_heading">साझाकरण और सुरक्षा</string>
    <string name="privacy_sharing_body">खाता प्रणाली न होने के कारण Magnetrail कोई खाता प्रोफ़ाइल नहीं बेचता। Mobile Ads और UMP के माध्यम से Google डेटा संसाधित कर सकता है। उपलब्धि साझा करें बटन दिखाई देने वाली गेम स्क्रीन को अस्थायी ऐप कैश में कैप्चर करके Android Sharesheet खोलता है; Magnetrail प्राप्तकर्ता नहीं चुनता और अपलोड नहीं करता। साफ़ टेक्स्ट नेटवर्क ट्रैफ़िक बंद है, आवश्यक प्रोडक्शन मान न होने पर रिलीज़ सुरक्षित रूप से बंद रहती है, और संग्रहीत प्रगति Android बैकअप व डिवाइस ट्रांसफ़र से बाहर है।</string>
    <string name="privacy_children_heading">बच्चे और दर्शक</string>
    <string name="privacy_children_body">प्रोडक्शन रिलीज़ से पहले मालिक द्वारा जाँची सामान्य-दर्शक घोषणा अपेक्षित है। रिपॉज़िटरी में अभी सत्यापित Play Console लक्ष्य-दर्शक घोषणा नहीं है। मालिक द्वारा घोषणा और आयु संबंधी आवश्यकताएँ कॉन्फ़िगर व सत्यापित करने तक वितरण शुरू नहीं होना चाहिए।</string>
    <string name="privacy_choices_heading">आपके विकल्प</string>
    <string name="privacy_choices_body">जहाँ आवश्यक हो, गोपनीयता फ़ॉर्म सहमति विकल्प देखने देता है। आप तय कर सकते हैं कि उपलब्धि स्क्रीनशॉट साझा करना है या नहीं और ऐप डेटा साफ़ करके या अनइंस्टॉल करके स्थानीय गेम डेटा हटा सकते हैं।</string>
