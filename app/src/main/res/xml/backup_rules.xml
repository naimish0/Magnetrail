<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- M5 keeps progress/settings local. Upgrade installs preserve app data;
         cloud restore and device transfer do not copy it to another device. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
