    <string name="tutorial_description">Tutorial %1$d of %2$d. %3$s. %4$s %5$s</string>
    <string name="tutorial_header">LEARN %1$d OF %2$d · %3$s</string>
    <string name="tutorial_1_title">Follow the arrow</string>
    <string name="tutorial_1_message">The arrowhead shows its printed direction. A magnet can bend that route.</string>
    <string name="tutorial_1_prompt">Watch the hand, then tap the glowing arrow.</string>
    <string name="tutorial_2_title">Spot blockers</string>
    <string name="tutorial_2_message">Walls and other arrows stop a route. A failed launch changes nothing.</string>
    <string name="tutorial_2_prompt">Trace the glowing direction, then try the arrow.</string>
    <string name="tutorial_3_title">Read the field</string>
    <string name="tutorial_3_message">PULL brings an aligned arrow closer. PUSH sends it away.</string>
    <string name="tutorial_3_prompt">Watch the magnet rings, then tap the glowing arrow.</string>
    <string name="tutorial_4_title">Check the flip</string>
    <string name="tutorial_4_message">A successful magnetic move flips PULL to PUSH, or PUSH to PULL.</string>
    <string name="tutorial_4_prompt">After the move, pause and check the magnet again.</string>
    <string name="tutorial_5_title">Choose the order</string>
    <string name="tutorial_5_message">Your first move changes what can work next.</string>
    <string name="tutorial_5_prompt">Follow the hand, and notice what each move changes.</string>
    <string name="tutorial_6_title">Scan the board</string>
    <string name="tutorial_6_message">Before tapping, trace the arrowhead and check every aligned object.</string>
    <string name="tutorial_6_prompt">Scan first, then follow the hand through the sequence.</string>
    <string name="tutorial_7_title">Check visibility</string>
    <string name="tutorial_7_message">Only a visible aligned magnet can control an arrow. Objects can block its field.</string>
    <string name="tutorial_7_prompt">Follow the hand and watch which field is visible.</string>
    <string name="tutorial_8_title">Watch what opens</string>
    <string name="tutorial_8_message">Removing one arrow can expose a route or a different controller.</string>
    <string name="tutorial_8_prompt">After every tap, look again before following the hand.</string>
    <string name="tutorial_9_title">Compare choices</string>
    <string name="tutorial_9_message">Two arrows may look safe, but they can create different future boards.</string>
    <string name="tutorial_9_prompt">Use the hand to study one reliable sequence.</string>
    <string name="tutorial_10_title">Put it together</string>
    <string name="tutorial_10_message">Read direction, blockers, field, polarity, and order before every move.</string>
    <string name="tutorial_10_prompt">Complete the guided sequence, then you are ready to play alone.</string>
    <string name="tutorial_next_prompt">Nice. Follow the hand to the next arrow.</string>
    <string name="tutorial_restart_prompt">The guided path changed. Restart to show the step-by-step sequence again.</string>

