# Copy this file to release.properties for repo-local release switches and signing values, or
# provide the same keys through ~/.gradle/gradle.properties, CI secrets, or environment variables.
# The app's public AdMob identifiers are tracked in gradle.properties. Never commit credentials.

# Set true only for an owner-approved, uploadable production build.
MAGNETRAIL_PRODUCTION_RELEASE=false

# Optional authorized AdMob overrides. Google sample/test IDs are rejected for production.
MAGNETRAIL_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
MAGNETRAIL_REWARDED_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
MAGNETRAIL_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
MAGNETRAIL_APP_OPEN_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
MAGNETRAIL_ENABLE_LIVE_ADS=false

# M5 currently permits live ads only after the owner confirms a general-audience launch.
MAGNETRAIL_TARGET_AUDIENCE=general
MAGNETRAIL_PRIVACY_POLICY_URL=https://naimish0.github.io/Magnetrail/

# Owner-authorized upload key. The keystore and passwords must stay outside Git.
MAGNETRAIL_UPLOAD_STORE_FILE=/absolute/path/to/upload-key.jks
MAGNETRAIL_UPLOAD_KEY_ALIAS=REPLACE_WITH_ALIAS
MAGNETRAIL_UPLOAD_STORE_PASSWORD=REPLACE_WITH_SECRET
MAGNETRAIL_UPLOAD_KEY_PASSWORD=REPLACE_WITH_SECRET

# Developer analytics and crash reporting are intentionally deferred to the next release cycle.
